# ============================================================
# AI Video & Meeting Assistant - Environment Configuration
# ============================================================

# LLM API Keys (Optional if using local Ollama)
MISTRAL_API_KEY="your_mistral_api_key_here"

# Speech-to-Text API Keys
# Required only if processing Hinglish audio via Sarvam AI
SARVAM_API_KEY="your_sarvam_api_key_here"

# Local Whisper Model size ("tiny", "base", "small", "medium", "large")
WHISPER_MODEL="small"

# Ollama LLM Settings
OLLAMA_MODEL="llama3.2:latest"
OLLAMA_EMBED_MODEL="nomic-embed-text:latest"

# Redis Semantic Cache (Optional - fallback to direct ChromaDB RAG if offline)
REDIS_URL="redis://localhost:6379"
REDIS_CACHE_TTL=3600
REDIS_CACHE_DISTANCE_THRESHOLD=0.15

# Inngest Durable Orchestration
INNGEST_DEV=1
